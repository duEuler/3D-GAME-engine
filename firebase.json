{
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/iframe/misc_collect-cubes.html"
      },
      {
        "source": "/jogo",
        "destination": "/iframe/misc_collect-cubes.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|mjs|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.@(data|bin)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ]
      }
    ]
  }
}
