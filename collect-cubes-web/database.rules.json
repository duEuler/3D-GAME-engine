{
  "rules": {
    ".read": false,
    ".write": false,
    "collectCubes": {
      "leaderboards": {
        "$levelId": {
          "scores": {
            "$uid": {
              ".read": true,
              ".write": "auth != null && auth.uid == $uid && newData.child('score').isNumber() && newData.child('score').val() >= 0 && (!data.exists() || newData.child('score').val() >= data.child('score').val())"
            }
          },
          "live": {
            ".read": true,
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      },
      "presence": {
        "$uid": {
          ".read": true,
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isNumber()"
        }
      },
      "rooms": {
        "$roomCode": {
          ".read": "auth != null",
          ".write": "auth != null",
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          },
          "collectibles": {
            "$cubeId": {
              ".write": "auth != null"
            }
          }
        }
      },
      "matchmaking": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    }
  }
}
